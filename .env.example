# Copy to .env.local and fill in. NEVER commit .env.local, and NEVER put real keys in this file.
# One file serves both the Vite client (VITE_* only are exposed to the browser) and the Express server.

# Public site URL (used for sitemap, auth e-mail links, product share links). No trailing slash.
SITE_URL=http://localhost:5173

# ---- Safe for the browser (publishable key only) ----
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# ---- Server only: NEVER prefix with VITE_ ----
SUPABASE_SECRET_KEY=YOUR_ROTATED_SECRET_KEY
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

SUPABASE_S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-northeast-1
SUPABASE_S3_ACCESS_KEY_ID=YOUR_ROTATED_S3_ACCESS_KEY
SUPABASE_S3_SECRET_ACCESS_KEY=YOUR_ROTATED_S3_SECRET_KEY
SUPABASE_S3_PUBLIC_BUCKET=public-media
SUPABASE_S3_PRIVATE_BUCKET=private-uploads

PORT=3001

# Used only by `npm run bootstrap-admin` (remove the password afterwards)
ADMIN_BOOTSTRAP_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_BOOTSTRAP_PASSWORD=CHOOSE_A_STRONG_PASSWORD

# Fallback WhatsApp number (international digits). Editable later in /admin/settings.
WHATSAPP_PHONE_NUMBER=918939326710
